# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── 環境變數（含 API Key，絕對不能上傳）──────────────────────────────────────
.env
.env.*
!.env.example

# ── 字型檔案（體積大，由 CI 在執行時下載）────────────────────────────────────
# assets/fonts/ 目錄本身保留（.gitkeep），字型二進位檔不進 repo
assets/fonts/*.otf
assets/fonts/*.ttf
assets/fonts/*.ttc
assets/fonts/*.woff
assets/fonts/*.woff2

# ── Claude Code 本機設定（不應上傳）──────────────────────────────────────────
.claude/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── 作業系統 ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 執行期大型資料（不需備份至 GitHub）────────────────────────────────────────
# found_articles.json 為跨日累積候選池（600+ 筆），本機保留、不上傳
data/found_articles.json

# ── 日誌 ──────────────────────────────────────────────────────────────────────
logs/

# ── 測試 / 暫存 ───────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
*.log
